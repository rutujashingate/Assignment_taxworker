{
  "name": "miraflores-workpaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.17.0" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import": "tsx scripts/import-packet.ts",
    "validate:packet": "python3 scripts/validate_packet.py",
    "findings:generate": "tsx scripts/generate-findings.ts",
    "findings:check": "tsx scripts/generate-findings.ts --check --canonical",
    "test:canonical": "tsx scripts/test-canonical.ts",
    "audit:generate": "tsx scripts/generate-requirements-audit.ts",
    "audit:check": "tsx scripts/generate-requirements-audit.ts --check",
    "validate:canonical": "tsx scripts/test-canonical.ts --validate-only"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
