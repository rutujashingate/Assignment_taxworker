# Optional. Without this, scripts/app use the local Unix-socket database below.
DATABASE_URL=postgresql:///miraflores_workpaper?host=/tmp
# Signed demo sessions use per-session keys kept in PostgreSQL, not secret files.
# This demo identity switcher is not production authentication.

# A hosted release requires a reachable remote PostgreSQL TLS URL in the host
# secret manager. The local Unix-socket default above cannot work remotely.
